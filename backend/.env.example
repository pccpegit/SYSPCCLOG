# ============================================================
# SYSPCCLOG Backend - Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# Django
SECRET_KEY=your-very-secret-key-here-change-in-production
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ──
# Desarrollo: SQLite (por defecto, no necesitas configurar nada)
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3

# Producción: PostgreSQL (DigitalOcean Managed Database)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=syspcclog
# DB_USER=doadmin
# DB_PASSWORD=your-password
# DB_HOST=db-postgresql-xxx.ondigitalocean.com
# DB_PORT=25060

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Email (Production)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=noreply@pcc.com.pe

# Security (Production only)
# SECURE_SSL_REDIRECT=True

# Redis (required for caching, sessions, and Celery)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── OneDrive integration (SYSPCC-016) ──
# Defaults work out of the box for a personal Microsoft account (device code
# flow, no Azure AD app registration). Override once PCC registers its own
# Azure AD app / OneDrive for Business tenant. See config/settings/base.py
# for the full decision matrix.
# ONEDRIVE_CLIENT_ID=14d82eec-204b-4c2f-b7e8-296a70dab67e
# ONEDRIVE_TENANT=consumers
# ONEDRIVE_SHARE_SCOPE=organization

# Fernet key encrypting OneDriveToken.access_token/refresh_token at rest.
# REQUIRED in production (do not rely on the SECRET_KEY-derived fallback
# there). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ONEDRIVE_TOKEN_ENCRYPTION_KEY=
