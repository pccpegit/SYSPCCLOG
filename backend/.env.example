# ============================================================
# SYSPCCLOG Backend - Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# Django
SECRET_KEY=your-very-secret-key-here-change-in-production
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ──
# Desarrollo: SQLite (por defecto, no necesitas configurar nada)
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3

# Producción: PostgreSQL (DigitalOcean Managed Database)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=syspcclog
# DB_USER=doadmin
# DB_PASSWORD=your-password
# DB_HOST=db-postgresql-xxx.ondigitalocean.com
# DB_PORT=25060

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Email (Production)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=noreply@pcc.com.pe

# Security (Production only)
# SECURE_SSL_REDIRECT=True

# Redis (required for caching, sessions, and Celery)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
