# ============================================================
# SYSPCCLOG Backend - Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# Django
SECRET_KEY=your-very-secret-key-here-change-in-production
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ──
# Desarrollo: SQLite (por defecto, no necesitas configurar nada)
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3

# Producción: PostgreSQL (DigitalOcean Managed Database)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=syspcclog
# DB_USER=doadmin
# DB_PASSWORD=your-password
# DB_HOST=db-postgresql-xxx.ondigitalocean.com
# DB_PORT=25060

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Email (Production)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=noreply@pcc.com.pe

# Security (Production only)
# SECURE_SSL_REDIRECT=True

# Redis (required for caching, sessions, and Celery)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── OneDrive integration (SYSPCC-016 / SYSPCC-017) ──
# Optional integration: without ONEDRIVE_CLIENT_ID set, it stays disconnected
# and the connect/poll endpoints return a clear "OneDrive no configurado"
# error — the rest of the app is unaffected. Register an Azure AD app (or use
# a personal Microsoft account's public client id) to enable it. See
# config/settings/base.py for the full decision matrix.
# ONEDRIVE_CLIENT_ID=your-azure-app-client-id
# ONEDRIVE_TENANT=consumers
# ONEDRIVE_SHARE_SCOPE=organization

# Fernet key encrypting OneDriveToken.access_token/refresh_token at rest.
# REQUIRED in production (do not rely on the SECRET_KEY-derived fallback
# there). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ONEDRIVE_TOKEN_ENCRYPTION_KEY=

# ── Demo/seed data (SYSPCC-017) ──
# Shared login password used by `manage.py seed_demo` / `seed_demo_extra` for
# every demo account they create. NEVER used in production (both commands
# abort outside DEBUG=True — see apps/core/management/seed_guard.py).
# If unset, each command generates its own random password per run and
# prints it once to the console. Set this ONLY if you want `seed_demo` and
# `seed_demo_extra` to share the SAME demo password across separate runs —
# e.g. for a stable local/staging demo environment. Never commit a real value.
# SEED_DEMO_PASSWORD=

# ── RR. HH. — generador de contratos (SYSPCC-022) ──
# Clave de Anthropic para el asistente (solo extrae datos del pedido; nunca
# redacta contratos). Sin clave el módulo funciona en modo formulario.
ANTHROPIC_API_KEY=
HR_ASSISTANT_MODEL=claude-opus-5-5
# Fallback server-side de Anthropic (beta). Apagado por defecto: actívalo con
# HR_ASSISTANT_SERVER_FALLBACK=true SOLO tras validarlo con tu cuenta real; si la
# cuenta no tiene la beta, todas las extracciones fallarían con 502.
# HR_ASSISTANT_SERVER_FALLBACK=false
# Datos de la empresa que se imprimen en los contratos (sin secretos).
HR_COMPANY_NAME=
HR_COMPANY_RUC=
HR_COMPANY_ADDRESS=
HR_COMPANY_LEGAL_REP_NAME=
HR_COMPANY_LEGAL_REP_DNI=
HR_COMPANY_LEGAL_REP_TITLE=
HR_COMPANY_LEGAL_REP_POWERS=
# Remuneración mínima vital vigente (solo genera una advertencia).
# HR_MIN_WAGE=1130.00
# PDF: vacío = automático (habilitado si existe LibreOffice en la imagen).
# HR_PDF_ENABLED=
# HR_PRIVATE_ROOT=

# --- RR. HH. · análisis masivo de CVs (SYSPCC-023) ---
# Usa ANTHROPIC_API_KEY (arriba). Sin clave, el módulo muestra el aviso y no deja iniciar análisis.
# HR_CV_MODEL=claude-opus-5-5
# Profundidad de razonamiento: low | medium | high (menos = más barato).
# HR_CV_EFFORT=medium
# Despacho: celery (worker en la cola hr_cv, por defecto) | thread (demo sin worker; el proceso web usa hilos).
# HR_CV_DISPATCH=celery
# HR_CV_THREAD_WORKERS=2
# Límites de subida
# HR_CV_MAX_FILE_BYTES=10485760
# HR_CV_MAX_FILES_PER_REQUEST=25
# HR_CV_MAX_ITEMS_PER_ANALYSIS=500
# HR_CV_DAILY_LIMIT_PER_USER=500
# HR_CV_MAX_PAGES=20
# Reintentos / recuperación de CVs atascados (segundos)
# HR_CV_MAX_ATTEMPTS=4
# HR_CV_STALE_SECONDS=600
# Sugerencia (no decisión): umbrales de puntaje para Avanzar / Revisar
# HR_CV_SCORE_ADVANCE=75
# HR_CV_SCORE_REVIEW=50
# Retención opcional: borra análisis más antiguos que N días (0 = apagado). Se aplica con
#   python manage.py hr_cv_purge_orphans
# HR_CV_RETENTION_DAYS=0
# Precio por millón de tokens (USD) para calcular el costo real mostrado
# HR_CV_PRICE_IN_PER_MTOK=4
# HR_CV_PRICE_OUT_PER_MTOK=20

# --- RR. HH. · convocatoria y modo de prueba (SYSPCC-023, iteración 2) ---
# Proveedor de IA: anthropic (real, por defecto) | fake (modo de prueba gratis: fichas y requisitos SIMULADOS,
# sin clave ni costo). `fake` SOLO funciona con DEBUG=True (desarrollo local): con config.settings.production o
# config.settings.demo el servidor se niega a arrancar. No lo definas en Render.
# HR_CV_PROVIDER=fake
# Retardo simulado por CV (segundos; varía de forma determinista por archivo) y % de CVs que fallan a propósito
# (0-100, para probar la pantalla de errores; el reintento falla igual).
# HR_CV_FAKE_DELAY_SECONDS=1.5
# HR_CV_FAKE_FAIL_PERCENT=0
# Convocatoria (PDF / Word / imagen): límites del archivo y del texto que se lee.
# HR_CV_POSTING_MAX_FILE_BYTES=5242880
# HR_CV_POSTING_MAX_PAGES=10
# HR_CV_POSTING_MAX_TEXT_CHARS=12000
# Lectura con IA de la convocatoria (síncrona dentro de la petición: el timeout debe quedar bajo el del servidor).
# Modelo vacío = HR_CV_MODEL.
# HR_CV_POSTING_MODEL=
# HR_CV_POSTING_EFFORT=low
# HR_CV_POSTING_MAX_TOKENS=2000
# HR_CV_POSTING_TIMEOUT=40
# HR_CV_POSTING_MAX_IMAGE_PIXELS=12000000
# HR_CV_POSTING_MAX_COST_USD=0.50
# HR_CV_POSTING_DAILY_LIMIT_PER_USER=40
